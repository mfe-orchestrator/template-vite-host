# Where the orchestrator backend lives, including the /api suffix.
VITE_MFE_BACKEND_URL=https://console.mfe-orchestrator.dev/api

# Id of your project in the orchestrator.
VITE_MFE_PROJECT_ID=

# Optional. Environment slug, ex. DEV / STAGE / PROD. Leave it unset or empty and
# the backend resolves the environment from the domain this host is served from,
# out of the domains declared for each environment in the console. Set it when
# one domain serves several environments, or when you want to pin it explicitly.
VITE_MFE_ENVIRONMENT=
